{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npx turbo build --filter=@syncero/docs",
  "outputDirectory": "apps/docs/dist",
  "headers": [
    {
      "source": "/(.*\\.yaml)",
      "headers": [
        { "key": "Content-Type", "value": "text/yaml; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*\\.json)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
