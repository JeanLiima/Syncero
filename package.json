{
  "name": "syncero",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "dev:landing": "turbo dev --filter=@syncero/landing",
    "dev:flow": "turbo dev --filter=@syncero/flow",
    "dev:books": "turbo dev --filter=@syncero/books",
    "build:landing": "turbo build --filter=@syncero/landing",
    "build:flow": "turbo build --filter=@syncero/flow",
    "build:books": "turbo build --filter=@syncero/books"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=18"
  }
}
